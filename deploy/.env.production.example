# Plantilla del .env de PRODUCCION (EC2 Amazon Linux, SQLite, acceso por DuckDNS, HTTP).
# setup-ec2.sh la copia a /var/www/dsj/.env y ajusta APP_URL y DB_DATABASE.
# Este archivo es solo plantilla: NUNCA pongas claves reales aqui.

APP_NAME=DSJ
APP_ENV=production
# Se genera en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Nombre estable en DuckDNS, sin barra final. La IP publica de la instancia
# cambia en cada arranque, pero este nombre se actualiza solo (ver
# deploy/duckdns/), asi que esta linea no hay que tocarla.
APP_URL=http://<subdominio>.duckdns.org

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# En produccion no queremos debug: solo warning y peor.
LOG_LEVEL=warning

# --- Base de datos: SQLite (sin servidor, ahorra RAM en la t3.micro) ---
# Ruta ABSOLUTA. El directorio database/ debe ser escribible por nginx.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/dsj/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Mientras el sitio sea HTTP puro esto DEBE quedar en false, o no habra login.
# Al activar HTTPS con dominio, cambiar a true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Gemini se usa solo desde el backend (App\Services\RecomendacionProductoService).
# Sin esta clave, la seccion de recomendaciones del home lanzara error.
GEMINI_API_KEY=<TU_API_KEY_DE_GEMINI>
GEMINI_MODEL=gemini-3.6-flash
