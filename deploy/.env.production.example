# Plantilla del .env de PRODUCCION (EC2, MySQL local, acceso por IP, sin HTTPS).
# Copiar a /var/www/dsj/.env en el servidor y rellenar lo marcado con <...>.
# Este archivo es solo plantilla: NUNCA pongas claves reales aqui.

APP_NAME=DSJ
APP_ENV=production
# Se genera en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# IP publica (o Elastic IP) de la instancia. Sin barra final.
APP_URL=http://<IP_PUBLICA_EC2>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# En produccion no queremos debug: solo warning y peor.
LOG_LEVEL=warning

# --- Base de datos: MySQL instalado en la misma EC2 ---
# Aqui NO va "mysql" (eso era el nombre del contenedor de Sail en desarrollo).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dsj
DB_USERNAME=dsj
DB_PASSWORD=<PASSWORD_FUERTE_DE_MYSQL>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Mientras el sitio sea HTTP puro esto DEBE quedar en false, o no habra login.
# Al activar HTTPS con dominio, cambiar a true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Gemini se usa solo desde el backend (App\Services\RecomendacionProductoService).
# Sin esta clave, la seccion de recomendaciones del home lanzara error.
GEMINI_API_KEY=<TU_API_KEY_DE_GEMINI>
GEMINI_MODEL=gemini-3.6-flash
